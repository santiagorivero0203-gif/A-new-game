        { "x": 1380, "y": 700 }
      ],
      "dialogues": {
        "lines": [
          "Vigilo el paso hacia la Garganta del Roble. Ten cuidado con el pasillo estrecho: emboscan desde las rocas.",
          "Si derrotas al Guardián Zarza, toda Aldea del Alba respirará libre al fin."
        ],
        "liberated": "¡Has derrotado al Guardián Zarza! ¡El valle entero celebra tu hazaña, Santi!"
      }
    },
    {
      "type": "npc",
      "id": "villager_m1_npc",
      "name": "Aldeana Mara",
      "variant": "villager",
      "role": "villager",
