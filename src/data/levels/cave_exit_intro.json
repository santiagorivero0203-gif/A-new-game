    {
      "type": "npc",
      "id": "valerio_m1_npc",
      "name": "Valerio el Escudero",
      "variant": "valerio",
      "role": "rescue",
      "rescueTag": "ambush_valerio",
      "karmaEventId": "valerio_m1",
      "rewardShield": "iron_pavise",
      "rewardEssence": 18,
      "x": 1136,
      "y": 276,
      "dialogues": {
        "underThreat": "¡Cuidado! Estas bestias me acorralaron tras el puente. ¡Limpia la emboscada!",
        "rescueComplete": "¡Gracias por acudir! Toma este Pavés de Hierro (revísalo en el Arsenal [I]): detiene impactos mucho mejor que la madera.",
        "highKarma": "Tu compasión ya resuena en Aldea del Alba, Santi. Ese Pavés de Hierro honra tu guardia.",
        "lowKarma": "Sobreviví por poco... Usa bien el Pavés de Hierro antes de cruzar la Garganta del Roble.",
        "lines": [
          "En Aldea del Alba te esperan el Herrero Brennan y Elara la Herborista antes de entrar en la Garganta.",
          "El Guardián Zarza protege el portal oriental tras su escudo de roble. Quémalo con Fuego [Clic Der / K]."
        ]
      }
    },
    {
      "type": "npc",
      "id": "tarak_m1_npc",
      "name": "Sabio Tarak",
      "variant": "tarak",
      "role": "sage",
      "x": 1164,
      "y": 584,
      "dialogues": {
        "highKarma": "Ayudaste a Valerio en el claro norte. Los artesanos de la aldea ya comentan tu nobleza, Santi.",
        "lowKarma": "El poder crece rápido cuando se camina sin mirar atrás, mas la aldea y la Reliquia recuerdan tus pasos.",
        "lines": [
          "Has llegado a Aldea del Alba. Fortalece tu hoja en la herrería o prepara tónicos antes de cruzar la Garganta.",
          "Tras el desfiladero aguarda un antiguo subjefe que sella la Gran Plaza."
        ]
      }
    },
    {
      "type": "npc",
      "id": "brennan_m1_npc",
      "name": "Herrero Brennan",
      "variant": "blacksmith",
      "role": "blacksmith",
      "biome": "cave_exit_intro",
      "shopTitle": "Yunque de Aldea del Alba",
      "shopSubtitle": "«El acero del Alba merece un buen temple antes de cruzar la Garganta del Roble.»",
      "x": 1396,
      "y": 520,
      "dialogues": {
        "lines": [
          "¡Saludos, portador! Con Esencia Ancestral puedo afilar tu Espada del Alba y reforzar tu guardia."
        ]
      }
    },
    {
      "type": "npc",
      "id": "elara_m1_npc",
      "name": "Elara la Herborista",
      "variant": "alchemist",
      "role": "alchemist",
      "biome": "cave_exit_intro",
      "shopTitle": "Boticaria Silvestre del Alba",
      "shopSubtitle": "«Destilo elixires de vitalidad, brisa y éter con hierbas frescas del valle.»",
      "x": 1100,
      "y": 904,
      "dialogues": {
        "lines": [
          "Mis frascos restauran y amplían permanentemente tus reservas antes del combate."
        ]
      }
    },
    {
      "type": "npc",
      "id": "guard_m1_npc",
      "name": "Centinela Darío",
      "variant": "guard",
      "role": "guard",
      "biome": "cave_exit_intro",
