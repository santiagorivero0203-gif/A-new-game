    {
      "type": "npc",
      "id": "valerio_m3_npc",
      "name": "Valerio el Explorador",
      "variant": "valerio",
      "role": "sage",
      "x": 276,
      "y": 556,
      "dialogues": {
        "highKarma": "Volver a encontrarte aquí da ánimos, Santi. El puente norte conduce al Yunque del Núcleo Cinético.",
        "lowKarma": "Santi... La caldera devora a quienes confían solo en su fuerza bruta. Toma primero el desvío norte.",
        "lines": [
          "Los guerreros de la Caldera visten coraza volcánica: la Embestida la hace trizas.",
          "Bastión Forjaceniza aún resiste en el centro; visita su forja y alambique antes de cruzar el puente de magma."
        ]
      }
    },
    {
      "type": "npc",
      "id": "brasa_m3_npc",
      "name": "Maestra Brasa",
      "variant": "blacksmith",
      "role": "blacksmith",
      "biome": "ash_caldera",
      "shopTitle": "Gran Fragua Forjaceniza",
      "shopSubtitle": "«Acero volcánico para demoler armaduras del Crisol.»",
      "x": 1004,
      "y": 632,
      "dialogues": {
        "lines": [
          "¡Mi yunque arde sin descanso! Trae tu Esencia para templar la Espada del Alba contra corazas pesadas."
        ]
      }
    },
    {
      "type": "npc",
      "id": "ignis_m3_npc",
      "name": "Alquimista Ignis",
      "variant": "alchemist",
      "role": "alchemist",
      "biome": "ash_caldera",
      "shopTitle": "Alambique del Magma",
      "shopSubtitle": "«Elixires templados en ceniza azul para resistir el calor del Crisol.»",
      "x": 644,
      "y": 852,
      "dialogues": {
        "lines": [
          "Un buen frasco de Furia Arcana hará temblar hasta al mismísimo Alcaide de Magma."
        ]
      }
    },
    {
      "type": "npc",
      "id": "guard_m3_npc",
      "name": "Centinela Durn",
      "variant": "guard",
      "role": "guard",
      "biome": "ash_caldera",
      "x": 884,
      "y": 572,
      "patrolPoints": [
        { "x": 884, "y": 572 },
        { "x": 884, "y": 692 }
      ],
      "dialogues": {
        "lines": [
          "El Puente Estrecho de Magma está vigilado por el Alcaide. Rompe sus escudos con Embestida."
        ],
        "liberated": "¡El Coloso ha caído! ¡Los yunques de Forjaceniza vuelven a cantar en paz!"
      }
    },
    {
      "type": "npc",
      "id": "villager_m3_npc",
      "name": "Fundidor Torg",
      "variant": "villager",
      "role": "villager",
      "biome": "ash_caldera",
      "wanderRadius": 44,
      "x": 728,
      "y": 684,
      "dialogues": {
        "lines": [
          "El herrero Borin bajó a la Fragua Sur y no ha regresado; por favor échale un ojo."
        ],
        "liberated": "¡Eres una leyenda viviente en la Caldera, Santi!"
      }
    },
    {
      "type": "npc",
      "id": "borin_m3_npc",
      "name": "Herrero Borin",
      "variant": "tarak",
      "role": "rescue",
      "rescueTag": "ambush_forge",
      "karmaEventId": "forge_keeper_m3",
      "rewardShield": "obsidian_aegis",
      "rewardEssence": 26,
      "x": 704,
      "y": 1136,
      "dialogues": {
        "underThreat": "¡Por la fragua! ¡Esos acorazados han tomado mi yunque sur! ¡Usa Embestida para romper su coraza!",
        "rescueComplete": "¡Qué impacto tan certero! Toma esta Égida de Obsidiana en el Arsenal [I]: resiste el fuego sin fisuras.",
        "highKarma": "Tu temple bajo las brasas honra a la vieja orden. Esa Égida de Obsidiana te salvará en la Ciudadela Astral.",
        "lowKarma": "Gracias por despejar mi fragua. Quédate con la Égida de Obsidiana para resistir al Coloso.",
        "lines": [
          "Si cruzas el puente occidental hallarás mi obra maestra: el Temple de Magma del Alba.",
          "Impacta los dos Pilares Cinéticos y vence al Alcaide para abrir el Crisol del este."
