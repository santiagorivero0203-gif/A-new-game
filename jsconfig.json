{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strictNullChecks": false
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "dist"]
}

